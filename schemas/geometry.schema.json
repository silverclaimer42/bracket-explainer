{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/silverclaimer42/bracket-explainer/schemas/geometry.schema.json",
  "title": "Normalised geometry",
  "description": "Triangulated surface geometry emitted by the CAD parser (packages/cad-parser) and consumed by the meshing bot. All lengths are in millimetres.",
  "type": "object",
  "required": ["units", "sourceFormat", "parts"],
  "additionalProperties": false,
  "properties": {
    "units": { "const": "mm" },
    "sourceFormat": { "enum": ["stl", "step"] },
    "parts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/part" }
    }
  },
  "$defs": {
    "vec3": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 3,
      "maxItems": 3
    },
    "bbox": {
      "type": "object",
      "required": ["min", "max"],
      "additionalProperties": false,
      "properties": {
        "min": { "$ref": "#/$defs/vec3" },
        "max": { "$ref": "#/$defs/vec3" }
      }
    },
    "part": {
      "type": "object",
      "required": ["id", "name", "vertices", "triangles", "bbox", "surfaceArea", "volume", "watertight"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "vertices": {
          "description": "Flat array of xyz triples: [x0, y0, z0, x1, y1, z1, ...]. Duplicates merged within 1e-6 mm.",
          "type": "array",
          "items": { "type": "number" }
        },
        "triangles": {
          "description": "Flat array of vertex-index triples, counter-clockwise when viewed from outside.",
          "type": "array",
          "items": { "type": "integer", "minimum": 0 }
        },
        "bbox": { "$ref": "#/$defs/bbox" },
        "surfaceArea": { "description": "mm^2", "type": "number", "minimum": 0 },
        "volume": {
          "description": "Enclosed volume in mm^3; null when the mesh is not watertight.",
          "type": ["number", "null"],
          "minimum": 0
        },
        "watertight": {
          "description": "True when every edge is shared by exactly two triangles.",
          "type": "boolean"
        }
      }
    }
  }
}
